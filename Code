Python
def calculate_bmr(weight_kg: float, height_cm: float, age: int, gender: str) -> float:
    if gender.lower() == 'm':
        return (10.0 * weight_kg) + (6.25 * height_cm) - (5.0 * age) + 5.0
    else:
        return (10.0 * weight_kg) + (6.25 * height_cm) - (5.0 * age) - 161.0

def calculate_tdee(bmr: float, activity_choice: int) -> float:
    multipliers = {
        1: 1.2,    # Sedentary
        2: 1.375,  # Lightly Active
        3: 1.55,   # Moderately Active
        4: 1.725,  # Very Active
        5: 1.9     # Extra Active
    }
    return bmr * multipliers.get(activity_choice, 1.0)

def main():
    print("=== Welcome to the Python Calorie Calculator ===\n")

    try:
        gender = input("Enter your gender (M/F): ").strip()
        age = int(input("Enter your age (years): "))
        weight = float(input("Enter your weight (in kg): "))
        height = float(input("Enter your height (in cm): "))

        print("\nSelect your daily activity level:")
        print("1. Sedentary (little or no exercise)")
        print("2. Lightly Active (light exercise 1-3 days/week)")
        print("3. Moderately Active (moderate exercise 3-5 days/week)")
        print("4. Very Active (hard exercise 6-7 days/week)")
        print("5. Extra Active (very hard exercise, physical job)")
        activity_choice = int(input("Enter choice (1-5): "))

        # Input Validation
        if age <= 0 or weight <= 0 or height <= 0 or gender.lower() not in ['m', 'f']:
            print("\nError: Invalid input data. Please run the program again with valid metrics.")
            return

        # Calculations
        bmr = calculate_bmr(weight, height, age, gender)
        tdee = calculate_tdee(bmr, activity_choice)

        # Results Display
        print("\n================ RESULTS ================")
        print(f"Your Basal Metabolic Rate (BMR): {bmr:.2f} kcal/day")
        print(f"Your Maintenance Calories (TDEE): {tdee:.2f} kcal/day")
        print("-----------------------------------------")
        print(f"To Lose Weight (-500 kcal):       {tdee - 500:.2f} kcal/day")
        print(f"To Gain Weight (+500 kcal):       {tdee + 500:.2f} kcal/day")
        print("=========================================")

    except ValueError:
        print("\nError: Invalid input format. Please enter numeric values where required.")

if __name__ == "__main__":
    main()
