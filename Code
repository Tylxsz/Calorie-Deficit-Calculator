#include <iostream>
#include <iomanip>
#include <string>

using namespace std;

// Function to calculate BMR using the Mifflin-St Jeor Equation
double calculateBMR(double weightKg, double heightCm, int age, char gender) {
    if (gender == 'M' || gender == 'm') {
        return (10.0 * weightKg) + (6.25 * heightCm) - (5.0 * age) + 5.0;
    } else {
        return (10.0 * weightKg) + (6.25 * heightCm) - (5.0 * age) - 161.0;
    }
}

// Function to calculate Total Daily Energy Expenditure (TDEE) based on activity
double calculateTDEE(double bmr, int activityChoice) {
    switch (activityChoice) {
        case 1: return bmr * 1.2;    // Sedentary
        case 2: return bmr * 1.375;  // Lightly Active
        case 3: return bmr * 1.55;   // Moderately Active
        case 4: return bmr * 1.725;  // Very Active
        case 5: return bmr * 1.9;    // Extra Active
        default: return bmr;         // Default to BMR if invalid choice
    }
}

int main() {
    // Variables
    double weight, height, bmr, tdee;
    int age, activityChoice;
    char gender;

    // Formatting output to display 2 decimal places
    cout << fixed << setprecision(2);

    cout << "=== Welcome to the C++ Calorie Calculator ===\n\n";

    // User inputs
    cout << "Enter your gender (M/F): ";
    cin >> gender;

    cout << "Enter your age (years): ";
    cin >> age;

    cout << "Enter your weight (in kg): ";
    cin >> weight;

    cout << "Enter your height (in cm): ";
    cin >> height;

    // Output and select activity multiplier
    cout << "\nSelect your daily activity level:\n";
    cout << "1. Sedentary (little or no exercise)\n";
    cout << "2. Lightly Active (light exercise 1-3 days/week)\n";
    cout << "3. Moderately Active (moderate exercise 3-5 days/week)\n";
    cout << "4. Very Active (hard exercise 6-7 days/week)\n";
    cout << "5. Extra Active (very hard exercise, physical job)\n";
    cout << "Enter choice (1-5): ";
    cin >> activityChoice;

    // Input Validation
    if (age <= 0 || weight <= 0 || height <= 0 || (gender != 'M' && gender != 'm' && gender != 'F' && gender != 'f')) {
        cout << "\nError: Invalid input data. Please run the program again with valid metrics.\n";
        return 1;
    }

    // Calculations
    bmr = calculateBMR(weight, height, age, gender);
    tdee = calculateTDEE(bmr, activityChoice);

    // Results Display
    cout << "\n================ RESULTS ================\n";
    cout << "Your Basal Metabolic Rate (BMR): " << bmr << " kcal/day\n";
    cout << "Your Maintenance Calories (TDEE): " << tdee << " kcal/day\n";
    cout << "-----------------------------------------\n";
    cout << "To Lose Weight (-500 kcal):       " << (tdee - 500) << " kcal/day\n";
    cout << "To Gain Weight (+500 kcal):       " << (tdee + 500) << " kcal/day\n";
    cout << "=========================================\n";

    return 0;
}

